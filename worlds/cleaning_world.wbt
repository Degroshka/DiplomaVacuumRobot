#VRML_SIM R2025a utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  title "Indoor RGB-D cleaning robot navigation scene"
  basicTimeStep 32
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 0.362 0.863 0.352 4.189
  position 4.8 -6.3 4.2
}
TexturedBackground { }
TexturedBackgroundLight { }

# Large bounded apartment-like room. The floor is intentionally not plain:
# visual SLAM needs corners, texture, contrast, and non-repeating landmarks.
RectangleArena {
  floorSize 9 7
  wallHeight 1.2
  floorTileSize 1 1
  floorAppearance PBRAppearance {
    baseColor 0.72 0.70 0.64
    roughness 0.9
    metalness 0
  }
  wallAppearance PBRAppearance {
    baseColor 0.86 0.86 0.82
    roughness 0.8
  }
}

# Visual landmarks on walls: high contrast objects help visual navigation features.
Solid {
  translation -3.8 3.43 0.65
  rotation 1 0 0 1.5708
  name "blue_wall_marker"
  children [
    Shape { appearance PBRAppearance { baseColor 0.05 0.18 0.9 roughness 0.6 } geometry Box { size 0.75 0.04 0.45 } }
  ]
}
Solid {
  translation -1.2 3.43 0.7
  rotation 1 0 0 1.5708
  name "orange_wall_marker"
  children [
    Shape { appearance PBRAppearance { baseColor 1.0 0.45 0.05 roughness 0.6 } geometry Box { size 0.65 0.04 0.42 } }
  ]
}
Solid {
  translation 2.4 3.43 0.78
  rotation 1 0 0 1.5708
  name "green_wall_marker"
  children [
    Shape { appearance PBRAppearance { baseColor 0.05 0.65 0.22 roughness 0.6 } geometry Box { size 0.85 0.04 0.50 } }
  ]
}

# Carpet with asymmetric colors and corners for feature extraction.
Solid {
  translation -1.3 -1.0 0.004
  name "asymmetric_carpet"
  children [
    Shape { appearance PBRAppearance { baseColor 0.20 0.24 0.28 roughness 1 } geometry Box { size 2.2 1.25 0.008 } }
    Transform { translation -0.45 0.18 0.005 children [ Shape { appearance PBRAppearance { baseColor 0.82 0.82 0.78 roughness 1 } geometry Box { size 0.55 0.08 0.002 } } ] }
    Transform { translation 0.55 -0.30 0.005 children [ Shape { appearance PBRAppearance { baseColor 0.95 0.55 0.10 roughness 1 } geometry Box { size 0.45 0.10 0.002 } } ] }
  ]
  # Visual-only carpet: it stays visible to the RGB camera for feature extraction,
  # but it is not a collision obstacle.  A real robot-vacuum should be able to
  # drive onto a carpet; the navigation code must reject carpet texture visually,
  # not rely on a physical blocking box.
}

# Furniture / obstacles: different height, size and colors for CV testing.
Solid {
  translation -3.0 -2.0 0.32
  name "low_sofa"
  children [
    Shape { appearance PBRAppearance { baseColor 0.22 0.25 0.36 roughness 0.85 } geometry Box { size 1.9 0.75 0.55 } }
    Transform { translation 0 0.37 0.28 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.18 0.26 roughness 0.9 } geometry Box { size 1.9 0.12 0.45 } } ] }
  ]
  boundingObject Box { size 1.9 0.75 0.55 }
}
# Open-under table made from separate solids. It is intentionally NOT a solid block:
# the robot can clean under the tabletop if it fits between the legs. This is a
# better test for a vacuum cleaner than the earlier one-piece table collision box.
Solid {
  translation 1.9 -2.0 0.70
  name "real_table_top_open_under"
  children [
    Shape { appearance PBRAppearance { baseColor 0.52 0.32 0.16 roughness 0.7 } geometry Box { size 1.30 0.85 0.08 } }
  ]
  boundingObject Box { size 1.30 0.85 0.08 }
}
Solid {
  translation 1.35 -2.35 0.34
  name "real_table_leg_front_left"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.07 0.07 0.68 } } ]
  boundingObject Box { size 0.07 0.07 0.68 }
}
Solid {
  translation 2.45 -2.35 0.34
  name "real_table_leg_front_right"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.07 0.07 0.68 } } ]
  boundingObject Box { size 0.07 0.07 0.68 }
}
Solid {
  translation 1.35 -1.65 0.34
  name "real_table_leg_back_left"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.07 0.07 0.68 } } ]
  boundingObject Box { size 0.07 0.07 0.68 }
}
Solid {
  translation 2.45 -1.65 0.34
  name "real_table_leg_back_right"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.07 0.07 0.68 } } ]
  boundingObject Box { size 0.07 0.07 0.68 }
}

