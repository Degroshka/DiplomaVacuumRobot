}
Solid {
  translation 2.44 -0.91 0.17
  name "real_chair_leg_fl"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.055 0.055 0.34 } } ]
  boundingObject Box { size 0.055 0.055 0.34 }
}
Solid {
  translation 2.86 -0.91 0.17
  name "real_chair_leg_fr"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.055 0.055 0.34 } } ]
  boundingObject Box { size 0.055 0.055 0.34 }
}
Solid {
  translation 2.44 -0.49 0.17
  name "real_chair_leg_bl"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.055 0.055 0.34 } } ]
  boundingObject Box { size 0.055 0.055 0.34 }
}
Solid {
  translation 2.86 -0.49 0.17
  name "real_chair_leg_br"
  children [ Shape { appearance PBRAppearance { baseColor 0.34 0.20 0.10 roughness 0.75 } geometry Box { size 0.055 0.055 0.34 } } ]
